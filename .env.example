# Copy to .env (scripts/setup.sh and scripts/setup.ps1 do this and ask for the values).

# --- Tailscale mode (the default) -------------------------------------------------------------
# Tailscale auth key for the watchman node. Make a reusable, pre-authorized key in the admin
# console (Settings > Keys). Tag it if your ACLs need one, then set TS_EXTRA_ARGS below.
# In OIDC mode leave the placeholder: the sidecar is not started.
TS_AUTHKEY=tskey-auth-...

# Node name on the tailnet. Partners get this node shared into their tailnet.
WATCHMAN_NODE_NAME=watchman

# Extra flags for tailscale up, for example --advertise-tags=tag:watchman
TS_EXTRA_ARGS=

# Loopback port inside the sidecar's namespace. Only change it if deploy/tailscale/serve.json changes too.
WATCHMAN_PORT=8030

# --- OIDC mode (ADR-027, docs/self-host.md) ---------------------------------------------------
# For households that sign in with their own OpenID Connect provider (Pocket ID, for example)
# behind their own reverse proxy instead of Tailscale. Uncomment the two COMPOSE_ lines so plain
# `docker compose` adds deploy/compose.oidc.yaml.
# COMPOSE_FILE=compose.yaml:deploy/compose.oidc.yaml
# COMPOSE_PATH_SEPARATOR=:
# WATCHMAN_OIDC_ISSUER=https://id.example.home
# WATCHMAN_OIDC_CLIENT_ID=
# WATCHMAN_OIDC_CLIENT_SECRET=
# WATCHMAN_OIDC_REDIRECT_URL=https://watchman.example.home/auth/callback
# Host address and port your reverse proxy forwards to.
# WATCHMAN_PUBLISH=127.0.0.1:8030
# How long a portal sign-in lasts, in hours.
# WATCHMAN_SESSION_HOURS=168
