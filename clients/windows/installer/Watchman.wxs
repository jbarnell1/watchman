<?xml version="1.0" encoding="UTF-8"?>
<!-- Watchman for Windows: the service (SYSTEM) and the helper, under Program Files. Built by CI
     with WiX 5 from the published output of both projects (see .github/workflows/windows.yml). -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Watchman" Manufacturer="Watchman" Version="0.1.0" UpgradeCode="5c0a2a6e-0a7e-4c4c-9c1e-2b0f3f1c7a11"
           Scope="perMachine" Language="1033">
    <MajorUpgrade DowngradeErrorMessage="A newer version of Watchman is installed." />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="mark.ico" SourceFile="$(var.Brand)\mark.ico" />
    <Property Id="ARPPRODUCTICON" Value="mark.ico" />
    <Property Id="ARPNOMODIFY" Value="1" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Watchman">
        <Directory Id="ServiceFolder" Name="service" />
        <Directory Id="HelperFolder" Name="helper" />
      </Directory>
    </StandardDirectory>

    <ComponentGroup Id="ServiceComponents" Directory="ServiceFolder">
      <Files Include="$(var.ServicePublish)\**" />
      <Component Id="WatchmanServiceInstall" Guid="1b8d0d9c-2b4a-4f4c-8b1a-5d9f0e3f0c21">
        <File Id="WatchmanService.exe" Source="$(var.ServicePublish)\WatchmanService.exe" KeyPath="yes" />
        <ServiceInstall Id="WatchmanService" Name="Watchman" DisplayName="Watchman" Description="Household accountability and real-time protection."
                        Type="ownProcess" Start="auto" Account="LocalSystem" ErrorControl="normal" Vital="yes">
          <ServiceDependency Id="Tcpip" />
        </ServiceInstall>
        <ServiceControl Id="WatchmanServiceControl" Name="Watchman" Start="install" Stop="both" Remove="uninstall" Wait="yes" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="HelperComponents" Directory="HelperFolder">
      <Files Include="$(var.HelperPublish)\**" />
      <Component Id="HelperIcon" Guid="9e2c7b40-5a3e-4b9b-a0a7-6f1d2c3b4a55">
        <File Id="mark.ico.helper" Source="$(var.Brand)\mark.ico" Name="mark.ico" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <Feature Id="Main" Title="Watchman" Level="1">
      <ComponentGroupRef Id="ServiceComponents" />
      <ComponentGroupRef Id="HelperComponents" />
    </Feature>
  </Package>
</Wix>
